@page "/tickets"
@using Microsoft.EntityFrameworkCore
@using TicketTriage.Infrastructure.Persistence
@inject IDbContextFactory<TriageDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Pending review · TriAIge</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Pending review</MudText>

<MudTable T="TriageSuggestionEntity" Items="_pending" Loading="_pending is null" Hover Dense
          OnRowClick="OpenReview">
    <HeaderContent>
        <MudTh>Ticket</MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Decision</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Ticket">@context.TicketKey</MudTd>
        <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="Decision">@context.Decision</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No suggestions waiting for review.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<TriageSuggestionEntity>? _pending;

    protected override async Task OnInitializedAsync()
    {
        // TODO: implement - paging, filtering, and populating suggestions via the triage pipeline.
        await using var db = await DbFactory.CreateDbContextAsync();
        _pending = await db.TriageSuggestions
            .AsNoTracking()
            .Where(s => s.Decision == ReviewDecision.Pending)
            .OrderBy(s => s.CreatedAt)
            .ToListAsync();
    }

    private void OpenReview(TableRowClickEventArgs<TriageSuggestionEntity> args)
    {
        if (args.Item is { } item)
        {
            Navigation.NavigateTo($"review/{item.Id}");
        }
    }
}
