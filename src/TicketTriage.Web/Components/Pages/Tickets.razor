@page "/tickets"

<PageTitle>Tickets · TriAIge</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Tickets</MudText>

@if (Progress is { Total: > 0 } progress)
{
    <MudText Typo="Typo.body2" Class="mb-1">@progress.Analysed of @progress.Total analysed</MudText>
    <MudProgressLinear Color="Color.Primary" Value="@(100.0 * progress.Analysed / progress.Total)" Class="mb-4" />
}

<MudChipSet T="TicketDisplayState?" SelectedValue="_filter" SelectedValueChanged="SetFilter"
            SelectionMode="SelectionMode.SingleSelection" Class="mb-4">
    <MudChip Value="@((TicketDisplayState?)null)">All (@_rows.Count)</MudChip>
    @foreach (var state in Enum.GetValues<TicketDisplayState>())
    {
        <MudChip Value="@((TicketDisplayState?)state)">@state (@_rows.Count(r => r.State == state))</MudChip>
    }
</MudChipSet>

<MudDataGrid T="TicketBoardRow" Items="FilteredRows" RowClick="OpenReview" Hover Dense
             RowClassFunc="@((TicketBoardRow _, int _) => "tt-row-clickable")">
    <Columns>
        <TemplateColumn Title="" Sortable="false">
            <CellTemplate>
                <TrafficLight State="context.Item.State" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Id" Title="#" />
        <PropertyColumn Property="x => x.IssueKey" Title="Issue key" />
        <PropertyColumn Property="x => x.Summary" Title="Summary" />
        <TemplateColumn Title="Work type" Sortable="false">
            <CellTemplate>
                @context.Item.WorkType
                @if (context.Item.SuggestedWorkType is { } suggested)
                {
                    <MudText Typo="Typo.caption" Class="d-block">suggested: @suggested</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Priority" Sortable="false">
            <CellTemplate>
                @context.Item.Priority
                @if (context.Item.SuggestedPriority is { } suggestedPriority)
                {
                    <MudText Typo="Typo.caption" Class="d-block">suggested: @suggestedPriority</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="State" Sortable="false">
            <CellTemplate>
                @context.Item.State
                @if (context.Item.State == TicketDisplayState.Failed)
                {
                    <span @onclick:stopPropagation="true">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   OnClick="@(() => RequeueAsync(context.Item.Id))">
                            Re-queue
                        </MudButton>
                    </span>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>No tickets in triage yet - upload a file to get started.</MudText>
    </NoRecordsContent>
</MudDataGrid>
