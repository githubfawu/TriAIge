@page "/review/{Id:int}"
@implements IDisposable

<PageTitle>Review · TriAIge</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_data is null)
{
    <MudAlert Severity="Severity.Warning">Ticket #@Id was not found.</MudAlert>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">Review ticket #@_data.Id @(_data.IssueKey != "—" ? $"({_data.IssueKey})" : "")</MudText>
        @if (_data.State is { } state)
        {
            <TrafficLight State="state" Large="true" />
        }
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Outlined Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Original</MudText>
                <MudText Typo="Typo.subtitle1" Class="mb-1">@_data.Summary</MudText>
                @if (_data.Description is { } description)
                {
                    <MudText Typo="Typo.body2" Class="mb-2" Style="white-space: pre-wrap;">@description</MudText>
                }
                <MudSimpleTable Dense Elevation="0">
                    <tbody>
                        <tr><td>Work type</td><td>@_data.OriginalWorkType</td></tr>
                        <tr><td>Affected service</td><td>@(_data.OriginalAffectedService ?? "—")</td></tr>
                        <tr><td>Service team</td><td>@(_data.OriginalServiceTeam ?? "—")</td></tr>
                        <tr><td>Assignee</td><td>@(_data.OriginalAssignee ?? "—")</td></tr>
                        <tr><td>Urgency</td><td>@(_data.OriginalUrgency ?? "—")</td></tr>
                        <tr><td>Impact</td><td>@(_data.OriginalImpact ?? "—")</td></tr>
                        <tr><td>Priority</td><td>@(_data.OriginalPriority ?? "—")</td></tr>
                        <tr><td>Resolution</td><td>@(_data.OriginalResolution ?? "—")</td></tr>
                    </tbody>
                </MudSimpleTable>

                @if (_data.Comments.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Comments</MudText>
                    @foreach (var comment in _data.Comments)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1" Style="white-space: pre-wrap;">@comment</MudText>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            @if (_data.IsTrainingTicket)
            {
                <MudAlert Severity="Severity.Info">Not part of triage (training data).</MudAlert>
            }
            else if (_data.State is TicketDisplayState.Queued or TicketDisplayState.Analysing)
            {
                <MudAlert Severity="Severity.Info" Class="mb-2">Agent is analysing…</MudAlert>
                <MudProgressLinear Indeterminate Color="Color.Info" />
            }
            else if (_data.State is TicketDisplayState.Failed)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">Analysis failed: @(_data.FailureReason ?? "unknown reason")</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RequeueAsync">Re-queue</MudButton>
            }
            else if (_data.State is TicketDisplayState.Approved or TicketDisplayState.Rejected)
            {
                <MudAlert Severity="@(_data.State == TicketDisplayState.Approved ? Severity.Success : Severity.Error)">
                    This ticket has been @(_data.State == TicketDisplayState.Approved ? "approved" : "rejected") - decisions are final.
                    @if (_data.State == TicketDisplayState.Rejected && _data.RejectReason is { } rejectReason)
                    {
                        <div>Reason: @rejectReason</div>
                    }
                </MudAlert>
            }
            else if (!_data.HasSuggestion)
            {
                <MudAlert Severity="Severity.Info" Class="mb-2">This ticket hasn't been analysed yet.</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AnalyseNowAsync">Analyse now</MudButton>
            }
            else if (_form is not null)
            {
                <MudPaper Outlined Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Suggested / edited</MudText>

                    @if (BaselineHasNoChanges)
                    {
                        <MudAlert Severity="Severity.Info" Dense Class="mb-2">No changes suggested.</MudAlert>
                    }

                    <MudStack Spacing="3">
                        <div class="@FieldClass(ReviewField.WorkType)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Work type</MudText>
                                <OwnerBadge Field="ReviewField.WorkType" />
                            </MudStack>
                            <MudSelect T="WorkType" @bind-Value="_form.WorkType" Dense="true">
                                @foreach (var value in Enum.GetValues<WorkType>())
                                {
                                    <MudSelectItem T="WorkType" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(ReviewField.WorkType))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.WorkType)</MudText>
                            }
                        </div>

                        <div class="@FieldClass(ReviewField.AffectedService)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Affected service</MudText>
                                <OwnerBadge Field="ReviewField.AffectedService" />
                            </MudStack>
                            <MudSelect T="string" @bind-Value="_form.AffectedService" Dense="true" Clearable="true">
                                @foreach (var name in _data.AllAffectedServiceNames)
                                {
                                    <MudSelectItem T="string" Value="name">@name</MudSelectItem>
                                }
                            </MudSelect>
                            <div>
                                @foreach (var name in _data.AllAffectedServiceNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="mr-1 mb-1"
                                             Color="@(name == _form.AffectedService ? Color.Primary : Color.Default)"
                                             OnClick="@(() => _form.AffectedService = name)">@name</MudChip>
                                }
                            </div>
                            @if (Hint(ReviewField.AffectedService) is { } affectedServiceHint)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">@affectedServiceHint</MudText>
                            }
                            else if (Differs(ReviewField.AffectedService))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.AffectedService)</MudText>
                            }
                        </div>

                        <div class="@FieldClass(ReviewField.ServiceTeam)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Service team</MudText>
                                <OwnerBadge Field="ReviewField.ServiceTeam" />
                            </MudStack>
                            <MudSelect T="string" @bind-Value="_form.ServiceTeam" Dense="true" Clearable="true">
                                @foreach (var name in _data.AllServiceTeamNames)
                                {
                                    <MudSelectItem T="string" Value="name">@name</MudSelectItem>
                                }
                            </MudSelect>
                            <div>
                                @foreach (var name in _data.AllServiceTeamNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="mr-1 mb-1"
                                             Color="@(name == _form.ServiceTeam ? Color.Primary : Color.Default)"
                                             OnClick="@(() => _form.ServiceTeam = name)">@name</MudChip>
                                }
                            </div>
                            @if (Hint(ReviewField.ServiceTeam) is { } serviceTeamHint)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">@serviceTeamHint</MudText>
                            }
                            else if (Differs(ReviewField.ServiceTeam))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.ServiceTeam)</MudText>
                            }
                        </div>

                        <div class="@FieldClass(ReviewField.Assignee)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Assignee</MudText>
                                <OwnerBadge Field="ReviewField.Assignee" />
                            </MudStack>
                            <MudTextField T="string" @bind-Value="_form.Assignee" MaxLength="50" Immediate="true" id="review-assignee-input" />
                            @if (Hint(ReviewField.Assignee) is { } assigneeHint)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">@assigneeHint</MudText>
                            }
                            else if (Differs(ReviewField.Assignee))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.Assignee)</MudText>
                            }
                        </div>

                        <MudStack Row Spacing="2">
                            <div class="flex-grow-1 @FieldClass(ReviewField.Urgency)">
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Urgency</MudText>
                                    <OwnerBadge Field="ReviewField.Urgency" />
                                </MudStack>
                                <MudSelect T="Urgency" @bind-Value="_form.Urgency" Dense="true">
                                    @foreach (var value in Enum.GetValues<Urgency>())
                                    {
                                        <MudSelectItem T="Urgency" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (Differs(ReviewField.Urgency))
                                {
                                    <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.Urgency)</MudText>
                                }
                            </div>

                            <div class="flex-grow-1 @FieldClass(ReviewField.Impact)">
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Impact</MudText>
                                    <OwnerBadge Field="ReviewField.Impact" />
                                </MudStack>
                                <MudSelect T="Impact" @bind-Value="_form.Impact" Dense="true">
                                    @foreach (var value in Enum.GetValues<Impact>())
                                    {
                                        <MudSelectItem T="Impact" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (Differs(ReviewField.Impact))
                                {
                                    <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.Impact)</MudText>
                                }
                            </div>
                        </MudStack>

                        <MudText Typo="Typo.body1">
                            <b>Priority: @TriageVocabulary.ToJsonName(_form.Priority)</b>
                        </MudText>

                        <div class="@FieldClass(ReviewField.Resolution)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Resolution</MudText>
                                <OwnerBadge Field="ReviewField.Resolution" />
                            </MudStack>
                            <MudSelect T="ResolutionStatus?" @bind-Value="_form.Resolution" Dense="true" Clearable="true">
                                @foreach (var value in Enum.GetValues<ResolutionStatus>())
                                {
                                    <MudSelectItem T="ResolutionStatus?" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Hint(ReviewField.Resolution) is { } resolutionHint)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">@resolutionHint</MudText>
                            }
                            else if (Differs(ReviewField.Resolution))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(ReviewField.Resolution)</MudText>
                            }
                        </div>

                        <div>
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Comment</MudText>
                                <OwnerBadge Field="ReviewField.Comment" />
                            </MudStack>
                            <MudTextField T="string" @bind-Value="_form.Comment" Lines="4" MaxLength="500" />
                        </div>
                    </MudStack>

                    <MudStack Row Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Outlined" OnClick="ResetForm" Disabled="_busy" id="review-reset-button">Reset</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RejectAsync" Disabled="_busy" id="review-reject-button">Reject</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AcceptAsync" Disabled="@(!CanAccept)" id="review-accept-button">Accept</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!CanSave)" id="review-save-button">Save</MudButton>
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined Class="pa-4 mt-4">
                    <MudText Typo="Typo.h6" Class="mb-2">References &amp; confidence</MudText>
                    @if (_data.SimilarTicketKeys.Count > 0)
                    {
                        <div>
                            @foreach (var key in _data.SimilarTicketKeys)
                            {
                                <MudChip T="string" Size="Size.Small" Class="mr-1 mb-1">@key</MudChip>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">No references</MudText>
                    }
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Confidence: @(_data.Confidence is > 0 ? _data.Confidence.Value.ToString("P0") : "—")
                    </MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
