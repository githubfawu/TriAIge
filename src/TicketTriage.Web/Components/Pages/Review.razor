@page "/review/{Id:int}"
@implements IAsyncDisposable

<PageTitle>Review · TriAIge</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_review is null)
{
    <a class="tt-back" href="tickets"><MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />Tickets</a>
    <MudAlert Severity="Severity.Warning" Class="mt-3">Ticket #@Id was not found.</MudAlert>
}
else
{
    <header class="tt-detail-header">
        <div class="tt-detail-heading">
            <a class="tt-back" href="tickets"><MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />Tickets</a>
            <div class="tt-detail-title">
                <span class="tt-key">@_review.Ticket.Key</span>
                <h1 class="tt-detail-subject">@_review.Ticket.Summary</h1>
            </div>
        </div>
        <div class="tt-detail-actions">
            @if (_state is { } state)
            {
                <TrafficLight State="state" Large="true" />
            }
            @if (_form is not null && _state is TicketDisplayState.Pending)
            {
                <span class="tt-actions-divider"></span>
                <MudButton Variant="Variant.Text" OnClick="ResetForm" Disabled="_busy" id="review-reset-button"
                           StartIcon="@Icons.Material.Outlined.Undo">Reset</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RejectAsync" Disabled="_busy" id="review-reject-button">Reject</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" DropShadow="false" OnClick="SaveAsync" Disabled="@(!CanSave)" id="review-save-button">Save changes</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" DropShadow="false" OnClick="AcceptAsync" Disabled="@(!CanAccept)" id="review-accept-button"
                           StartIcon="@Icons.Material.Outlined.Check">Accept</MudButton>
            }
        </div>
    </header>

    <div class="tt-detail">
        <main class="tt-detail-main">
            <section class="tt-card">
                <div class="tt-card-title">
                    <MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" Size="Size.Small" />
                    Original ticket
                </div>
                @if (_review.Ticket.Description is { } description)
                {
                    <p class="tt-description">@description</p>
                }
                <dl class="tt-facts">
                    <div><dt>Work type</dt><dd>@(_review.Ticket.WorkType ?? "—")</dd></div>
                    <div><dt>Affected service(s)</dt><dd>@(OriginalAffectedServices ?? "—")</dd></div>
                    <div><dt>Service team(s)</dt><dd>@(OriginalServiceTeam ?? "—")</dd></div>
                    <div><dt>Assignee</dt><dd>@(_review.Ticket.Assignee ?? "—")</dd></div>
                    <div><dt>Urgency</dt><dd>@(_review.Ticket.Urgency ?? "—")</dd></div>
                    <div><dt>Impact</dt><dd>@(_review.Ticket.Impact ?? "—")</dd></div>
                    <div><dt>Priority</dt><dd>@(_review.Ticket.Priority ?? "—")</dd></div>
                    <div><dt>Resolution</dt><dd>@(_review.Ticket.Resolution ?? "—")</dd></div>
                </dl>
            </section>

            @if (_review.Ticket.Comments.Count > 0)
            {
                <section class="tt-card">
                    <div class="tt-card-title">
                        <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" />
                        Comments <span class="tt-count">@_review.Ticket.Comments.Count</span>
                    </div>
                    <ol class="tt-timeline">
                        @foreach (var comment in _review.Ticket.Comments)
                        {
                            <li><span class="tt-timeline-dot"></span><p>@comment</p></li>
                        }
                    </ol>
                </section>
            }

            @if (_review.Suggestion is { } suggestion)
            {
                <section class="tt-card">
                    <div class="tt-card-title">
                        <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Small" />
                        Similar tickets
                        <span class="tt-card-hint">used as references by the agent</span>
                    </div>
                    @if (suggestion.SimilarTicketKeys is { Count: > 0 } keys)
                    {
                        <div class="tt-tags">
                            @foreach (var key in keys)
                            {
                                <span class="tt-tag">@key</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="tt-muted">No references</p>
                    }
                </section>
            }
        </main>

        <aside class="tt-side">
            <div class="tt-side-title">Triage details</div>

            @if (_state is TicketDisplayState.Analysing or TicketDisplayState.Queued)
            {
                <div class="tt-note tt-note-info">
                    @(_state == TicketDisplayState.Queued
                        ? "Queued - the agent will analyse this ticket shortly. This page updates by itself."
                        : "Agent is analysing…")
                </div>
                <MudProgressLinear Indeterminate Color="Color.Info" Rounded="true" Class="mt-2" />
            }
            else if (_state is TicketDisplayState.Failed)
            {
                <div class="tt-note tt-note-error">Analysis failed: @(_failureReason ?? "unknown reason")</div>
                <MudButton Variant="Variant.Filled" Color="Color.Error" DropShadow="false" OnClick="RequeueAsync" Disabled="_busy" Class="mt-3" FullWidth="true">Re-queue</MudButton>
            }
            else if (_state is TicketDisplayState.Approved or TicketDisplayState.Rejected)
            {
                <div class="tt-note @(_state == TicketDisplayState.Approved ? "tt-note-success" : "tt-note-error")">
                    This ticket has been @(_state == TicketDisplayState.Approved ? "approved" : "rejected") - decisions are final.
                    @if (_state == TicketDisplayState.Rejected && _review.Decision?.RejectReason is { } rejectReason)
                    {
                        <div class="tt-note-detail">Reason: @rejectReason</div>
                    }
                </div>
            }
            else if (_form is null)
            {
                <div class="tt-note tt-note-info">This ticket hasn't been analysed yet.</div>
            }
            else
            {
                @if (_review.Suggestion is { IsFallback: true })
                {
                    <div class="tt-note tt-note-warning">This is a fallback suggestion (the agent could not produce one).</div>
                }
                else if (BaselineHasNoChanges)
                {
                    <div class="tt-note tt-note-info">No changes suggested.</div>
                }

                <div class="tt-fields">
                    <div class="tt-field @FieldClass(SuggestionField.WorkType)">
                        <div class="tt-field-label"><span>Work type</span><OwnerBadge Field="SuggestionField.WorkType" /></div>
                        <MudSelect T="WorkType" @bind-Value="_form.WorkType" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var value in Enum.GetValues<WorkType>())
                            {
                                <MudSelectItem T="WorkType" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Differs(SuggestionField.WorkType))
                        {
                            <div class="tt-was">@WasText(SuggestionField.WorkType)</div>
                        }
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.AffectedServices)">
                        <div class="tt-field-label"><span>Affected service(s)</span><OwnerBadge Field="SuggestionField.AffectedServices" /></div>
                        <MudSelect T="string" MultiSelection="true" SelectedValues="_form.AffectedServices" SelectedValuesChanged="OnAffectedServicesChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var service in ServiceCatalog.All)
                            {
                                <MudSelectItem T="string" Value="service.Name">@service.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Differs(SuggestionField.AffectedServices))
                        {
                            <div class="tt-was">@WasText(SuggestionField.AffectedServices)</div>
                        }
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.ServiceTeams)">
                        <div class="tt-field-label"><span>Service team</span><OwnerBadge Field="SuggestionField.ServiceTeams" /></div>
                        <MudSelect T="string" @bind-Value="_form.ServiceTeam" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var team in ServiceTeamCatalog.All)
                            {
                                <MudSelectItem T="string" Value="team">@team</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Differs(SuggestionField.ServiceTeams))
                        {
                            <div class="tt-was">@WasText(SuggestionField.ServiceTeams)</div>
                        }
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.Assignee)">
                        <div class="tt-field-label"><span>Assignee</span><OwnerBadge Field="SuggestionField.Assignee" /></div>
                        <MudTextField T="string" @bind-Value="_form.Assignee" MaxLength="100" Immediate="true" id="review-assignee-input"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.PersonOutline" />
                        @if (Differs(SuggestionField.Assignee))
                        {
                            <div class="tt-was">@WasText(SuggestionField.Assignee)</div>
                        }
                    </div>

                    <div class="tt-field-row">
                        <div class="tt-field @FieldClass(SuggestionField.Urgency)">
                            <div class="tt-field-label"><span>Urgency</span><OwnerBadge Field="SuggestionField.Urgency" /></div>
                            <MudSelect T="Urgency" @bind-Value="_form.Urgency" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var value in Enum.GetValues<Urgency>())
                                {
                                    <MudSelectItem T="Urgency" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(SuggestionField.Urgency))
                            {
                                <div class="tt-was">@WasText(SuggestionField.Urgency)</div>
                            }
                        </div>

                        <div class="tt-field @FieldClass(SuggestionField.Impact)">
                            <div class="tt-field-label"><span>Impact</span><OwnerBadge Field="SuggestionField.Impact" /></div>
                            <MudSelect T="Impact" @bind-Value="_form.Impact" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var value in Enum.GetValues<Impact>())
                                {
                                    <MudSelectItem T="Impact" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(SuggestionField.Impact))
                            {
                                <div class="tt-was">@WasText(SuggestionField.Impact)</div>
                            }
                        </div>
                    </div>

                    <div class="tt-field">
                        <div class="tt-field-label"><span>Priority</span><span class="tt-field-help">urgency × impact</span></div>
                        <div class="tt-prio-scale" role="img" aria-label="Priority: @TriageVocabulary.ToJsonName(_form.Priority)">
                            @foreach (var level in Enum.GetValues<Priority>())
                            {
                                var name = TriageVocabulary.ToJsonName(level);
                                <span class="tt-prio-step @(level == _form.Priority ? "tt-prio tt-prio-" + name.ToLowerInvariant() : null)">@name</span>
                            }
                        </div>
                        <span class="tt-sr-only">Priority: @TriageVocabulary.ToJsonName(_form.Priority)</span>
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.ResolutionStatus)">
                        <div class="tt-field-label"><span>Resolution</span><OwnerBadge Field="SuggestionField.ResolutionStatus" /></div>
                        <MudSelect T="ResolutionStatus?" @bind-Value="_form.Resolution" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var value in Enum.GetValues<ResolutionStatus>())
                            {
                                <MudSelectItem T="ResolutionStatus?" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Differs(SuggestionField.ResolutionStatus))
                        {
                            <div class="tt-was">@WasText(SuggestionField.ResolutionStatus)</div>
                        }
                    </div>

                    <div class="tt-field">
                        <div class="tt-field-label"><span>Comment</span><OwnerBadge Field="SuggestionField.DraftComment" /></div>
                        <MudTextField T="string" @bind-Value="_form.Comment" Lines="6" MaxLength="2000" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                </div>
            }
        </aside>
    </div>
}
