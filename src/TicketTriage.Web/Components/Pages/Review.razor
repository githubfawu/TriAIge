@page "/review/{Id:int}"
@implements IAsyncDisposable

<PageTitle>Review · TriAIge</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_review is null)
{
    <MudAlert Severity="Severity.Warning">Ticket #@Id was not found.</MudAlert>
}
else
{
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">Review ticket #@Id (@_review.Ticket.Key)</MudText>
        @if (_state is { } state)
        {
            <TrafficLight State="state" Large="true" />
        }
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Outlined Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Original</MudText>
                <MudText Typo="Typo.subtitle1" Class="mb-1">@_review.Ticket.Summary</MudText>
                @if (_review.Ticket.Description is { } description)
                {
                    <MudText Typo="Typo.body2" Class="mb-2" Style="white-space: pre-wrap;">@description</MudText>
                }
                <MudSimpleTable Dense Elevation="0">
                    <tbody>
                        <tr><td>Work type</td><td>@(_review.Ticket.WorkType ?? "—")</td></tr>
                        <tr><td>Affected service(s)</td><td>@(OriginalAffectedServices ?? "—")</td></tr>
                        <tr><td>Service team(s)</td><td>@(OriginalServiceTeam ?? "—")</td></tr>
                        <tr><td>Assignee</td><td>@(_review.Ticket.Assignee ?? "—")</td></tr>
                        <tr><td>Urgency</td><td>@(_review.Ticket.Urgency ?? "—")</td></tr>
                        <tr><td>Impact</td><td>@(_review.Ticket.Impact ?? "—")</td></tr>
                        <tr><td>Priority</td><td>@(_review.Ticket.Priority ?? "—")</td></tr>
                        <tr><td>Resolution</td><td>@(_review.Ticket.Resolution ?? "—")</td></tr>
                    </tbody>
                </MudSimpleTable>

                @if (_review.Ticket.Comments.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Comments</MudText>
                    @foreach (var comment in _review.Ticket.Comments)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1" Style="white-space: pre-wrap;">@comment</MudText>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            @if (_state is TicketDisplayState.Analysing)
            {
                <MudAlert Severity="Severity.Info" Class="mb-2">Agent is analysing…</MudAlert>
                <MudProgressLinear Indeterminate Color="Color.Info" />
            }
            else if (_state is TicketDisplayState.Failed)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">Analysis failed: @(_failureReason ?? "unknown reason")</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RequeueAsync" Disabled="_busy">Re-queue</MudButton>
            }
            else if (_state is TicketDisplayState.Approved or TicketDisplayState.Rejected)
            {
                <MudAlert Severity="@(_state == TicketDisplayState.Approved ? Severity.Success : Severity.Error)">
                    This ticket has been @(_state == TicketDisplayState.Approved ? "approved" : "rejected") - decisions are final.
                    @if (_state == TicketDisplayState.Rejected && _review.Decision?.RejectReason is { } rejectReason)
                    {
                        <div>Reason: @rejectReason</div>
                    }
                </MudAlert>
            }
            else if (_form is null)
            {
                <MudAlert Severity="Severity.Info">This ticket hasn't been analysed yet.</MudAlert>
            }
            else
            {
                <MudPaper Outlined Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Suggested / edited</MudText>

                    @if (_review.Suggestion is { IsFallback: true })
                    {
                        <MudAlert Severity="Severity.Warning" Dense Class="mb-2">This is a fallback suggestion (the agent could not produce one).</MudAlert>
                    }
                    else if (BaselineHasNoChanges)
                    {
                        <MudAlert Severity="Severity.Info" Dense Class="mb-2">No changes suggested.</MudAlert>
                    }

                    <MudStack Spacing="3">
                        <div class="@FieldClass(SuggestionField.WorkType)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Work type</MudText>
                                <OwnerBadge Field="SuggestionField.WorkType" />
                            </MudStack>
                            <MudSelect T="WorkType" @bind-Value="_form.WorkType" Dense="true">
                                @foreach (var value in Enum.GetValues<WorkType>())
                                {
                                    <MudSelectItem T="WorkType" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(SuggestionField.WorkType))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.WorkType)</MudText>
                            }
                        </div>

                        <div class="@FieldClass(SuggestionField.AffectedServices)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Affected service(s)</MudText>
                                <OwnerBadge Field="SuggestionField.AffectedServices" />
                            </MudStack>
                            <MudSelect T="string" MultiSelection="true" SelectedValues="_form.AffectedServices" SelectedValuesChanged="OnAffectedServicesChanged" Dense="true">
                                @foreach (var service in ServiceCatalog.All)
                                {
                                    <MudSelectItem T="string" Value="service.Name">@service.Name</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(SuggestionField.AffectedServices))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.AffectedServices)</MudText>
                            }
                        </div>

                        <div class="@FieldClass(SuggestionField.ServiceTeams)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Service team</MudText>
                                <OwnerBadge Field="SuggestionField.ServiceTeams" />
                            </MudStack>
                            <MudSelect T="string" @bind-Value="_form.ServiceTeam" Dense="true" Clearable="true">
                                @foreach (var team in ServiceTeamCatalog.All)
                                {
                                    <MudSelectItem T="string" Value="team">@team</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(SuggestionField.ServiceTeams))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.ServiceTeams)</MudText>
                            }
                        </div>

                        <div class="@FieldClass(SuggestionField.Assignee)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Assignee</MudText>
                                <OwnerBadge Field="SuggestionField.Assignee" />
                            </MudStack>
                            <MudTextField T="string" @bind-Value="_form.Assignee" MaxLength="100" Immediate="true" id="review-assignee-input" />
                            @if (Differs(SuggestionField.Assignee))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.Assignee)</MudText>
                            }
                        </div>

                        <MudStack Row Spacing="2">
                            <div class="flex-grow-1 @FieldClass(SuggestionField.Urgency)">
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Urgency</MudText>
                                    <OwnerBadge Field="SuggestionField.Urgency" />
                                </MudStack>
                                <MudSelect T="Urgency" @bind-Value="_form.Urgency" Dense="true">
                                    @foreach (var value in Enum.GetValues<Urgency>())
                                    {
                                        <MudSelectItem T="Urgency" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (Differs(SuggestionField.Urgency))
                                {
                                    <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.Urgency)</MudText>
                                }
                            </div>

                            <div class="flex-grow-1 @FieldClass(SuggestionField.Impact)">
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">Impact</MudText>
                                    <OwnerBadge Field="SuggestionField.Impact" />
                                </MudStack>
                                <MudSelect T="Impact" @bind-Value="_form.Impact" Dense="true">
                                    @foreach (var value in Enum.GetValues<Impact>())
                                    {
                                        <MudSelectItem T="Impact" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (Differs(SuggestionField.Impact))
                                {
                                    <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.Impact)</MudText>
                                }
                            </div>
                        </MudStack>

                        <MudText Typo="Typo.body1">
                            <b>Priority: @TriageVocabulary.ToJsonName(_form.Priority)</b>
                        </MudText>

                        <div class="@FieldClass(SuggestionField.ResolutionStatus)">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Resolution</MudText>
                                <OwnerBadge Field="SuggestionField.ResolutionStatus" />
                            </MudStack>
                            <MudSelect T="ResolutionStatus?" @bind-Value="_form.Resolution" Dense="true" Clearable="true">
                                @foreach (var value in Enum.GetValues<ResolutionStatus>())
                                {
                                    <MudSelectItem T="ResolutionStatus?" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Differs(SuggestionField.ResolutionStatus))
                            {
                                <MudText Typo="Typo.caption">was: @OriginalDisplay(SuggestionField.ResolutionStatus)</MudText>
                            }
                        </div>

                        <div>
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">Comment</MudText>
                                <OwnerBadge Field="SuggestionField.DraftComment" />
                            </MudStack>
                            <MudTextField T="string" @bind-Value="_form.Comment" Lines="4" MaxLength="2000" />
                        </div>
                    </MudStack>

                    <MudStack Row Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Outlined" OnClick="ResetForm" Disabled="_busy" id="review-reset-button">Reset</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RejectAsync" Disabled="_busy" id="review-reject-button">Reject</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AcceptAsync" Disabled="@(!CanAccept)" id="review-accept-button">Accept</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!CanSave)" id="review-save-button">Save</MudButton>
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined Class="pa-4 mt-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Similar tickets</MudText>
                    @if (_review.Suggestion?.SimilarTicketKeys is { Count: > 0 } keys)
                    {
                        <div>
                            @foreach (var key in keys)
                            {
                                <MudChip T="string" Size="Size.Small" Class="mr-1 mb-1">@key</MudChip>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">No references</MudText>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
