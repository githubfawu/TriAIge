@page "/review/{Id:int}"
@implements IAsyncDisposable

<PageTitle>Review · TriAIge</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_review is null)
{
    <a class="tt-back" href="tickets"><MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />Tickets</a>
    <MudAlert Severity="Severity.Warning" Class="mt-3">Ticket #@Id was not found.</MudAlert>
}
else
{
    <header class="tt-detail-header">
        <div class="tt-detail-heading">
            <a class="tt-back" href="tickets"><MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />Tickets</a>
            <div class="tt-detail-title">
                <span class="tt-key">@_review.Ticket.Key</span>
                <h1 class="tt-detail-subject">@_review.Ticket.Summary</h1>
            </div>
        </div>
        <div class="tt-detail-actions">
            @if (_state is { } state)
            {
                <TrafficLight State="state" Large="true" />
            }
            @if (_form is not null && _state is TicketDisplayState.Pending)
            {
                @if (CountState(FieldState.Missing) is var toFix and > 0)
                {
                    <a class="tt-attention" href="@FirstAttentionAnchor"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" />@toFix to fix@(CountState(FieldState.Conflict) is var alsoReview and > 0 ? $" · {alsoReview} to review" : "")</a>
                }
                else if (CountState(FieldState.Conflict) is var toReview and > 0)
                {
                    <a class="tt-attention tt-attention-verify" href="@FirstAttentionAnchor"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" />@toReview to review</a>
                }
                else
                {
                    <span class="tt-attention tt-attention-ok"><MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Size="Size.Small" />Ready to accept</span>
                }
                <span class="tt-actions-divider"></span>
                <MudButton Variant="Variant.Text" OnClick="ResetForm" Disabled="_busy" id="review-reset-button"
                           StartIcon="@Icons.Material.Outlined.Undo">Reset</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RejectAsync" Disabled="_busy" id="review-reject-button">Reject</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" DropShadow="false" OnClick="SaveAsync" Disabled="@(!CanSave)" id="review-save-button">Save changes</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" DropShadow="false" OnClick="AcceptAsync" Disabled="@(!CanAccept)" id="review-accept-button"
                           StartIcon="@Icons.Material.Outlined.Check">Accept</MudButton>
            }
        </div>
    </header>

    <div class="tt-detail">
        <main class="tt-detail-main">
            <section class="tt-card">
                <div class="tt-card-title">
                    <MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" Size="Size.Small" />
                    Original ticket
                    <span class="tt-card-hint">as reported</span>
                </div>
                @if (_review.Ticket.Description is { } description)
                {
                    <p class="tt-description">@description</p>
                }
                <dl class="tt-facts">
                    <div><dt>Work type</dt><dd>@(_review.Ticket.WorkType ?? "—")</dd></div>
                    <div><dt>Affected service(s)</dt><dd>@(OriginalAffectedServices ?? "—")</dd></div>
                    <div><dt>Service team(s)</dt><dd>@(OriginalServiceTeam ?? "—")</dd></div>
                    <div><dt>Assignee</dt><dd>@(_review.Ticket.Assignee ?? "—")</dd></div>
                    <div><dt>Urgency</dt><dd>@(_review.Ticket.Urgency ?? "—")</dd></div>
                    <div><dt>Impact</dt><dd>@(_review.Ticket.Impact ?? "—")</dd></div>
                    <div><dt>Priority</dt><dd>@(_review.Ticket.Priority ?? "—")</dd></div>
                    <div><dt>Resolution</dt><dd>@(_review.Ticket.Resolution ?? "—")</dd></div>
                </dl>
            </section>

            @if (_review.Ticket.Comments.Count > 0)
            {
                <section class="tt-card">
                    <div class="tt-card-title">
                        <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" />
                        Comments <span class="tt-count">@_review.Ticket.Comments.Count</span>
                    </div>
                    <ol class="tt-timeline">
                        @foreach (var comment in _review.Ticket.Comments)
                        {
                            <li><span class="tt-timeline-dot"></span><p>@comment</p></li>
                        }
                    </ol>
                </section>
            }

            @if (_review.Suggestion is { } suggestion)
            {
                <section class="tt-card">
                    <div class="tt-card-title">
                        <MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Small" />
                        Similar tickets
                        <span class="tt-card-hint">used as references by the agent</span>
                    </div>
                    @if (suggestion.SimilarTicketKeys is { Count: > 0 } keys)
                    {
                        <div class="tt-tags">
                            @foreach (var key in keys)
                            {
                                <span class="tt-tag">@key</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="tt-muted">No references</p>
                    }
                </section>
            }
        </main>

        <aside class="tt-side">
            <div class="tt-side-title">Triage details</div>

            @if (_state is TicketDisplayState.Analysing or TicketDisplayState.Queued)
            {
                <div class="tt-note tt-note-info">
                    @(_state == TicketDisplayState.Queued
                        ? "Queued - the agent will analyse this ticket shortly. This page updates by itself."
                        : "Agent is analysing…")
                </div>
                <MudProgressLinear Indeterminate Color="Color.Info" Rounded="true" Class="mt-2" />
            }
            else if (_state is TicketDisplayState.Failed)
            {
                <div class="tt-note tt-note-error">Analysis failed: @(_failureReason ?? "unknown reason")</div>
                <MudButton Variant="Variant.Filled" Color="Color.Error" DropShadow="false" OnClick="RequeueAsync" Disabled="_busy" Class="mt-3" FullWidth="true">Re-queue</MudButton>
            }
            else if (_state is TicketDisplayState.Approved or TicketDisplayState.Rejected)
            {
                <div class="tt-note @(_state == TicketDisplayState.Approved ? "tt-note-success" : "tt-note-error")">
                    This ticket has been @(_state == TicketDisplayState.Approved ? "approved" : "rejected") - decisions are final.
                    @if (_state == TicketDisplayState.Rejected && _review.Decision?.RejectReason is { } rejectReason)
                    {
                        <div class="tt-note-detail">Reason: @rejectReason</div>
                    }
                </div>
            }
            else if (_form is null)
            {
                <div class="tt-note tt-note-info">This ticket hasn't been analysed yet.</div>
            }
            else
            {
                @if (_review.Suggestion is { IsFallback: true })
                {
                    <div class="tt-note tt-note-warning">This is a fallback suggestion (the agent could not produce one). Check every field.</div>
                }
                @if (CountState(FieldState.Missing) + CountState(FieldState.Conflict) > 0)
                {
                    <div class="tt-todo" role="alert">
                        <div class="tt-todo-title"><MudIcon Icon="@Icons.Material.Outlined.Checklist" Size="Size.Small" />Before you accept</div>
                        <ul>
                            @foreach (var field in FieldsIn(FieldState.Missing))
                            {
                                <li class="tt-todo-error"><a href="@FieldAnchor(field)">@TodoText(field)</a></li>
                            }
                            @foreach (var field in FieldsIn(FieldState.Conflict))
                            {
                                <li class="tt-todo-warning"><a href="@FieldAnchor(field)">@TodoText(field)</a></li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="tt-todo tt-todo-ok"><MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Size="Size.Small" />Ready to accept – nothing to fix or review.</div>
                }

                <div class="tt-fields">
                    <div class="tt-group">Classification</div>
                    <div class="tt-field @FieldClass(SuggestionField.WorkType)" id="@FieldId(SuggestionField.WorkType)">
                        <div class="tt-field-label"><span>Work type</span><span class="tt-label-right">@if (StateOf(SuggestionField.WorkType) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.WorkType).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.WorkType) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.WorkType" /></span></div>
                        <MudSelect T="WorkType" @bind-Value="_form.WorkType" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var value in Enum.GetValues<WorkType>())
                            {
                                <MudSelectItem T="WorkType" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Hint(SuggestionField.WorkType) is { } hintWorkType)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.WorkType).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.WorkType))" Size="Size.Small" />@hintWorkType</div>
                        }
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.AffectedServices)" id="@FieldId(SuggestionField.AffectedServices)">
                        <div class="tt-field-label"><span>Affected service(s)</span><span class="tt-label-right">@if (StateOf(SuggestionField.AffectedServices) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.AffectedServices).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.AffectedServices) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.AffectedServices" /></span></div>
                        <MudSelect T="string" MultiSelection="true" SelectedValues="_form.AffectedServices" SelectedValuesChanged="OnAffectedServicesChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var service in ServiceCatalog.All)
                            {
                                <MudSelectItem T="string" Value="service.Name">@service.Name</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Hint(SuggestionField.AffectedServices) is { } hintAffectedServices)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.AffectedServices).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.AffectedServices))" Size="Size.Small" />@hintAffectedServices</div>
                        }
                    </div>

                    <div class="tt-group">Routing</div>
                    <div class="tt-field @FieldClass(SuggestionField.ServiceTeams)" id="@FieldId(SuggestionField.ServiceTeams)">
                        <div class="tt-field-label"><span>Service team</span><span class="tt-label-right">@if (StateOf(SuggestionField.ServiceTeams) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.ServiceTeams).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.ServiceTeams) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.ServiceTeams" /></span></div>
                        <MudSelect T="string" @bind-Value="_form.ServiceTeam" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var team in ServiceTeamCatalog.All)
                            {
                                <MudSelectItem T="string" Value="team">@team</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Hint(SuggestionField.ServiceTeams) is { } hintServiceTeams)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.ServiceTeams).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.ServiceTeams))" Size="Size.Small" />@hintServiceTeams</div>
                        }
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.Assignee)" id="@FieldId(SuggestionField.Assignee)">
                        <div class="tt-field-label"><span>Assignee</span><span class="tt-label-right">@if (StateOf(SuggestionField.Assignee) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.Assignee).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.Assignee) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.Assignee" /></span></div>
                        <MudTextField T="string" @bind-Value="_form.Assignee" MaxLength="100" Immediate="true" id="review-assignee-input"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Outlined.PersonOutline" />
                        @if (Hint(SuggestionField.Assignee) is { } hintAssignee)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.Assignee).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.Assignee))" Size="Size.Small" />@hintAssignee</div>
                        }
                    </div>

                    <div class="tt-group">Priority</div>
                    <div class="tt-field-row">
                        <div class="tt-field @FieldClass(SuggestionField.Urgency)" id="@FieldId(SuggestionField.Urgency)">
                            <div class="tt-field-label"><span>Urgency</span><span class="tt-label-right">@if (StateOf(SuggestionField.Urgency) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.Urgency).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.Urgency) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.Urgency" /></span></div>
                            <MudSelect T="Urgency" @bind-Value="_form.Urgency" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var value in Enum.GetValues<Urgency>())
                                {
                                    <MudSelectItem T="Urgency" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Hint(SuggestionField.Urgency) is { } hintUrgency)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.Urgency).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.Urgency))" Size="Size.Small" />@hintUrgency</div>
                        }
                        </div>

                        <div class="tt-field @FieldClass(SuggestionField.Impact)" id="@FieldId(SuggestionField.Impact)">
                            <div class="tt-field-label"><span>Impact</span><span class="tt-label-right">@if (StateOf(SuggestionField.Impact) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.Impact).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.Impact) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.Impact" /></span></div>
                            <MudSelect T="Impact" @bind-Value="_form.Impact" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var value in Enum.GetValues<Impact>())
                                {
                                    <MudSelectItem T="Impact" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Hint(SuggestionField.Impact) is { } hintImpact)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.Impact).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.Impact))" Size="Size.Small" />@hintImpact</div>
                        }
                        </div>
                    </div>

                    <div class="tt-field">
                        <div class="tt-field-label"><span>Calculated priority</span><span class="tt-field-help">urgency × impact</span></div>
                        <div class="tt-prio-scale" role="img" aria-label="Priority: @TriageVocabulary.ToJsonName(_form.Priority)">
                            @foreach (var level in Enum.GetValues<Priority>())
                            {
                                var name = TriageVocabulary.ToJsonName(level);
                                <span class="tt-prio-step @(level == _form.Priority ? "tt-prio tt-prio-" + name.ToLowerInvariant() : null)">@name</span>
                            }
                        </div>
                        <span class="tt-sr-only">Priority: @TriageVocabulary.ToJsonName(_form.Priority)</span>
                    </div>

                    <div class="tt-group">Resolution</div>
                    <div class="tt-field @FieldClass(SuggestionField.ResolutionStatus)" id="@FieldId(SuggestionField.ResolutionStatus)">
                        <div class="tt-field-label"><span>Resolution</span><span class="tt-label-right">@if (StateOf(SuggestionField.ResolutionStatus) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.ResolutionStatus).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.ResolutionStatus) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.ResolutionStatus" /></span></div>
                        <MudSelect T="ResolutionStatus?" @bind-Value="_form.Resolution" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var value in Enum.GetValues<ResolutionStatus>())
                            {
                                <MudSelectItem T="ResolutionStatus?" Value="value">@TriageVocabulary.ToJsonName(value)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Hint(SuggestionField.ResolutionStatus) is { } hintResolutionStatus)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.ResolutionStatus).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.ResolutionStatus))" Size="Size.Small" />@hintResolutionStatus</div>
                        }
                    </div>

                    <div class="tt-field @FieldClass(SuggestionField.DraftComment)" id="@FieldId(SuggestionField.DraftComment)">
                        <div class="tt-field-label"><span>Comment</span><span class="tt-label-right">@if (StateOf(SuggestionField.DraftComment) is FieldState.Missing or FieldState.Conflict) { <span class="tt-flag tt-flag-@StateOf(SuggestionField.DraftComment).ToString().ToLowerInvariant()">@(StateOf(SuggestionField.DraftComment) == FieldState.Missing ? "Required" : "Review")</span> }<OwnerBadge Field="SuggestionField.DraftComment" /></span></div>
                        <MudTextField T="string" @bind-Value="_form.Comment" Lines="5" MaxLength="2000" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        @if (Hint(SuggestionField.DraftComment) is { } hintDraftComment)
                        {
                            <div class="tt-hint tt-hint-@StateOf(SuggestionField.DraftComment).ToString().ToLowerInvariant()"><MudIcon Icon="@HintIcon(StateOf(SuggestionField.DraftComment))" Size="Size.Small" />@hintDraftComment</div>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
}
