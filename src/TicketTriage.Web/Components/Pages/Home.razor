@page "/"
@using Microsoft.Extensions.Diagnostics.HealthChecks

<PageTitle>Dashboard · TriAIge</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Dashboard</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_loadingHealth">
        Refresh
    </MudButton>
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">Tickets by state</MudText>
<MudGrid Class="mb-4">
    @foreach (var state in Enum.GetValues<TicketDisplayState>())
    {
        <MudItem xs="6" md="2">
            <MudLink Href="@($"/tickets?state={state}")" Underline="Underline.None">
                <MudCard Outlined Class="tt-state-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h5">@CountFor(state)</MudText>
                        <MudText Typo="Typo.body2" Class="tt-state-label"><span class="tt-state-dot tt-dot-@state.ToString().ToLowerInvariant()"></span>@state</MudText>
                    </MudCardContent>
                </MudCard>
            </MudLink>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.subtitle1" Class="mb-2">Metrics</MudText>
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudText Typo="Typo.h5">@FormatRate(_metrics.AcceptanceRate)</MudText>
                <MudText Typo="Typo.body2">Acceptance rate (approved without edits / decided)</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudText Typo="Typo.h5">@_metrics.Approved approved / @_metrics.Rejected rejected</MudText>
                <MudText Typo="Typo.body2">Decisions (@_metrics.Decided of @_metrics.Suggested suggested)</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudText Typo="Typo.h5">@FormatDuration(_metrics.MedianIngestToFirstOpen)</MudText>
                <MudText Typo="Typo.body2">Median ingest &rarr; first open</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudText Typo="Typo.h5">@FormatDuration(_metrics.MedianIngestToDecision)</MudText>
                <MudText Typo="Typo.body2">Median ingest &rarr; decision</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.subtitle1" Class="mb-2">Edits per field (all decided tickets)</MudText>
<MudStack Row Wrap="Wrap.Wrap" Class="mb-4">
    @foreach (var (field, count) in _metrics.EditsPerField)
    {
        <MudChip T="string">@field: @count</MudChip>
    }
</MudStack>

<MudText Typo="Typo.subtitle1" Class="mb-2">System health (readiness checks)</MudText>

@if (_loadingHealth && _report is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (_report is not null)
{
    <MudGrid>
        @foreach (var name in DisplayedHealthChecks)
        {
            var entry = _report.Entries.TryGetValue(name, out var found) ? found : (HealthReportEntry?)null;
            <MudItem xs="12" md="6">
                <MudCard Outlined>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@name</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Color="@ColorFor(entry?.Status)" Variant="Variant.Filled">
                                @(entry?.Status.ToString() ?? "Not registered")
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">@(entry?.Description ?? "—")</MudText>
                        @if (entry is { } e)
                        {
                            <MudText Typo="Typo.caption">Checked in @e.Duration.TotalMilliseconds.ToString("F0") ms</MudText>
                            @foreach (var (key, value) in e.Data)
                            {
                                <MudText Typo="Typo.caption" Class="d-block">@key: @value</MudText>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <MudText Typo="Typo.caption" Class="mt-4 d-block">
        Overall: @_report.Status · last refreshed @_checkedAt.ToLocalTime().ToString("T")
        · the agent check is cached for 60 s to save tokens.
    </MudText>
}
