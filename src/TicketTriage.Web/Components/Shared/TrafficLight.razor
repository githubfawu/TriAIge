@* Reusable state indicator (FR12): colour, icon and text are always shown together, in both variants. *@

@if (Large)
{
    <div class="tl-large">
        <div class="tl-large-lights">
            <span class="tl-large-light tl-large-red @(IsRed ? "tl-large-lit" : "")"></span>
            <span class="tl-large-light tl-large-yellow @(IsYellow ? "tl-large-lit" : "")"></span>
            <span class="tl-large-light tl-large-green @(IsGreen ? "tl-large-lit" : "")"></span>
        </div>
        <div class="tl-large-label tl-@CssSuffix">
            <MudIcon Icon="@Icon" />
            <span>@Text</span>
        </div>
    </div>
}
else
{
    <div class="tl-dot tl-@CssSuffix">
        <MudIcon Icon="@Icon" Size="Size.Small" />
        <span>@Text</span>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TicketDisplayState State { get; set; }

    /// <summary>Large 3-light variant for the Review header (Slice 2); the dot variant (default) is used in the
    /// /tickets list.</summary>
    [Parameter]
    public bool Large { get; set; }

    private bool IsRed => State is TicketDisplayState.Failed or TicketDisplayState.Rejected;

    private bool IsYellow => State is TicketDisplayState.Queued or TicketDisplayState.Analysing or TicketDisplayState.Pending;

    private bool IsGreen => State is TicketDisplayState.Approved;

    private string CssSuffix => State switch
    {
        TicketDisplayState.Queued => "queued",
        TicketDisplayState.Analysing => "analysing",
        TicketDisplayState.Failed => "failed",
        TicketDisplayState.Pending => "pending",
        TicketDisplayState.Approved => "approved",
        TicketDisplayState.Rejected => "rejected",
        _ => "queued",
    };

    private string Icon => State switch
    {
        TicketDisplayState.Queued => Icons.Material.Filled.Schedule,
        TicketDisplayState.Analysing => Icons.Material.Filled.Autorenew,
        TicketDisplayState.Failed => Icons.Material.Filled.WarningAmber,
        TicketDisplayState.Pending => Icons.Material.Filled.RateReview,
        TicketDisplayState.Approved => Icons.Material.Filled.CheckCircle,
        TicketDisplayState.Rejected => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Schedule,
    };

    private string Text => State switch
    {
        TicketDisplayState.Queued => "Queued",
        TicketDisplayState.Analysing => "Analysing",
        TicketDisplayState.Failed => "Failed",
        TicketDisplayState.Pending => "Pending",
        TicketDisplayState.Approved => "Approved",
        TicketDisplayState.Rejected => "Rejected",
        _ => State.ToString(),
    };
}
